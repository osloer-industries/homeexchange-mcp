{
  "name": "homeexchange-mcp",
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "record": "ts-node src/record.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint && npm test",
    "analyze": "ts-node src/analyze.ts",
    "login": "ts-node src/login.ts",
    "mcp": "ts-node src/mcp.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Unofficial local MCP server for HomeExchange",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.0.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.58.2",
    "playwright": "1.58.2"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "6.28.0"
    },
    "@hono/node-server": "2.0.12",
