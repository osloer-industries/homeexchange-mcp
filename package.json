{
  "name": "homeexchange-mcp",
  "version": "0.1.6",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "record": "ts-node src/record.ts",
    "check": "npm run lint && npm run lint:suppressions && npm run check:no-claude-md && npm run lint:sonarjs && npm run lint:dup && npm run lint:md && npm run lint:md-links && npm run typecheck && npm run test:coverage && npm run build && npm run lint:knip",
    "check:fast": "npm run lint && npm run lint:suppressions && npm run typecheck && npm run lint:sonarjs && npm test",
    "check:no-claude-md": "node scripts/check-no-claude-md.mts",
    "lint": "oxlint -c .oxlintrc.json --type-aware src scripts/**/*.mts",
    "lint:suppressions": "node scripts/count-suppressions.mts",
    "lint:dup": "jscpd --config .jscpd.json",
    "lint:knip": "knip",
    "lint:md": "markdownlint-cli2",
    "lint:md-links": "markdown-link-check-repo --config .markdown-link-check.json",
    "lint:sonarjs": "node scripts/lint-sonarjs.mjs",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:sonar": "node scripts/run-sonar-coverage.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && npm run typecheck --prefix packages/eslint-sonarjs",
    "analyze": "ts-node src/analyze.ts",
    "login": "ts-node src/login.ts",
    "mcp": "ts-node src/mcp.ts",
    "mcp:local": "npm run build && node dist/mcp.js",
    "test:mcp": "npm run build && node scripts/test-mcp.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Unofficial local MCP server for HomeExchange",
  "devDependencies": {
    "@osloer-industries/markdown-link-check": "github:osloer-industries/markdown-link-check#v4.0.0-osloer.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.1",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2007",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.63.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "6.28.0"
    },
    "@hono/node-server": "2.1.8",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.13",
    "fast-uri": "3.1.9",
    "proxy-addr": "2.0.8",
    "flatted": "3.4.2",
    "hono": "4.13.18",
    "ip-address": "10.7.5",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "nanoid": "3.3.18",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "npm": "11.19.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.16.1",
    "zod": "4.6.7",
    "undici": "7.29.0"
  }
}