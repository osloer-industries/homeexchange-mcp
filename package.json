    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch": "10.2.4",
    "nanoid": "3.3.18",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "npm": "11.19.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.15.2",
    "undici": "7.29.0"
  }
