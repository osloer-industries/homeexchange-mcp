{
  "name": "homeexchange-mcp",
  "version": "0.0.1",
  "description": "Unofficial local MCP server for HomeExchange",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "record": "ts-node src/record.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "analyze": "ts-node src/analyze.ts",
    "login": "ts-node src/login.ts",
    "mcp": "ts-node src/mcp.ts"
  },
  "keywords": [
    "homeexchange",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.79.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.58.2",
    "playwright": "1.58.2"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "6.28.0"
    },
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch": "10.2.4",
    "nanoid": "3.3.18",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "npm": "11.19.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.15.2",
    "undici": "7.29.0"
  }
}
